<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mvcon.Host.MainWindow"
        Title="MVCON 工業自動化主控台 (C# + Avalonia)" Width="980" Height="600"
        WindowStartupLocation="CenterScreen">
    
    <Grid ColumnDefinitions="360,*">
        <!-- 左側：指令編輯與控制面板 -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#333" BorderThickness="0,0,1,0" Padding="15">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                
                <!-- 標題 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="MVCON 核心控制台" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0"/>
                    <TextBlock Text="指令語法：模組@指令::參數" FontSize="12" Foreground="Gray"/>
                </StackPanel>

                <!-- 模組清單 -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="已動態載入之 .csvi 模組：" FontSize="12" Foreground="#DDD"/>
                    <ListBox Name="LstModules" Height="80" SelectionChanged="OnModuleSelectionChanged"/>
                </StackPanel>

                <!-- 測試指令輸入框 -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="目前指令 (可編輯)：" FontSize="12" FontWeight="Bold" Foreground="#DDD"/>
                    <TextBox Name="TxtCommandLine" Text="DMM@MEAS_VOLT::{&quot;Channel&quot;:&quot;ai0&quot;,&quot;ScaleFactor&quot;:1.0,&quot;HighLimit&quot;:4.0}"
                             FontFamily="Consolas, Monaco, Courier New" Foreground="#CE9178"/>
                </StackPanel>

                <!-- 功能按鈕群 -->
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,10">
                    <!-- UI 1: 參數導引 -->
                    <Button Content="⚙ 編輯參數 (彈出 UI 1 導引視窗)" 
                            Click="OnEditParameterClick" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <!-- UI 2: 掛載/解除 SubPanel -->
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Content="📌 掛載 Front Panel" 
                                Click="OnMountFrontPanelClick" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="❌ 卸載 SubPanel" 
                                Click="OnUnmountFrontPanelClick" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- 底層執行 -->
                    <Button Content="⚡ 執行指令 (底層函數 / SubVI 模式)" 
                            Click="OnExecuteCommandClick" 
                            Background="#0E639C" Foreground="White"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <Separator Grid.Row="4" Background="#3E3E42" Margin="0,5,0,10"/>

                <!-- 執行輸出 Log -->
                <TextBlock Grid.Row="5" Text="執行日誌 (Log)：" FontSize="12" Foreground="#AAA" Margin="0,0,0,4"/>
                <Border Grid.Row="6" Background="#1E1E1E" CornerRadius="4" Padding="10">
                    <ScrollViewer>
                        <TextBlock Name="TxtLog" Text="[系統] MVCON 準備就緒..." FontFamily="Consolas" FontSize="11" Foreground="#88D49E" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 右側：像 LabVIEW 的 SubPanel (動態嵌入 Front Panel) -->
        <Border Grid.Column="1" Background="#181818" Padding="20">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="主畫面 SubPanel 容器區" FontSize="16" FontWeight="Bold" Foreground="#DDD"/>
                    <TextBlock Text="當前指令對應的模組可動態嵌入其即時面板，無縫監控數據" FontSize="12" Foreground="#777"/>
                </StackPanel>

                <!-- 核心：動態 ContentControl (SubPanel) -->
                <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#121212">
                    <ContentControl Name="SubPanelContainer">
                        <TextBlock Text="[目前尚未掛載任何 Front Panel]" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ContentControl>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
