<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DmmSensorModule.Views.DmmFrontPanelView">
    <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="15">
            <!-- 頂部標題區 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="DMM Front Panel" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0"/>
                    <TextBlock Text="(供 SubPanel 嵌入)" FontSize="12" Foreground="Gray" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#333" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding ActiveChannelText}" FontSize="12" Foreground="#DDD"/>
                </Border>
            </Grid>

            <!-- 核心即時顯示儀表 -->
            <Border Background="#111" CornerRadius="8" Padding="20" BorderBrush="#252526" BorderThickness="1">
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DisplayVoltageText}" FontSize="40" FontWeight="Bold" 
                               Foreground="{Binding DisplayColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="即時量測數值 (Volts)" FontSize="11" Foreground="#777" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 狀態指示燈與訊息 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#AAA" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="狀態：" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Width="14" Height="14" Fill="{Binding StatusLedColor}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
